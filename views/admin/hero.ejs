<%- include('../partials/header', { active: 'hero', pageTitle: 'Edit Hero Section' }) %>

<% if (saved) { %>
  <div class="alert alert-success"><i class="fas fa-check-circle"></i> Berhasil disimpan!</div>
<% } %>

<form method="POST" action="/admin/hero" enctype="multipart/form-data" class="editor-form">
  <div class="form-card">
    <div class="form-group">
      <label for="heading">Heading</label>
      <input type="text" id="heading" name="heading" value="<%= data.heading || '' %>" required>
      <small>Gunakan &lt;br /&gt; untuk baris baru</small>
    </div>
    <div class="form-group">
      <label for="subtitle">Subtitle</label>
      <textarea id="subtitle" name="subtitle" rows="3"><%= data.subtitle || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="heroImage">Gambar Hero (Background)</label>
      <% if (data.heroImage) { %>
        <div style="margin-bottom:10px">
          <img src="<%= data.heroImage %>" alt="Hero" style="max-width:100%;max-height:200px;border-radius:8px;border:1px solid #ddd">
        </div>
      <% } %>
      <input type="file" id="heroImage" name="heroImage" accept="image/*">
      <small>Upload gambar baru untuk mengganti background hero. Kosongkan jika tidak ingin mengubah.</small>
      <input type="hidden" name="existingImage" value="<%= data.heroImage || '' %>">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan</button>
      <a href="/admin" class="btn btn-secondary">Kembali</a>
    </div>
  </div>
</form>

<%- include('../partials/footer') %>
